{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Housing affordability: The impact of parenthood",
    "subtitle": [
      "Housing as a share of total household spending, before and after parenthood",
      "Source: ONS Living Costs and Food Survey 2022-2024"
    ],
    "fontSize": 18,
    "fontWeight": 700,
    "color": "#4b4a4a",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#646464"
  },
  "width": 500,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/camila-paredes-a/camila-paredes-a.github.io/refs/heads/main/c1_housing_spending.csv"
  },
  "transform": [
    {
      "fold": ["Housing % without children", "Housing % with children"],
      "as": ["Family status", "Housing share"]
    },
    {
      "calculate": "datum['Family status'] == 'Housing % without children' ? 'No children' : 'With children'",
      "as": "Status"
    }
  ],
  "mark": {"type": "bar", "cornerRadius": 2, "opacity": 1},
  "encoding": {
    "y": {
      "field": "Income quintile",
      "type": "ordinal",
      "sort": ["Q1", "Q2", "Q3", "Q4", "Q5"],
      "axis": {
        "title": "Income quintile",
        "titleFontWeight": 700,
        "titleFontSize": 12,
        "labelFontSize": 12,
        "labelColor": "#666666",
        "domainColor": "#d0d0d0",
        "domainWidth": 1.5,
        "labelPadding": 12,
        "ticks": false,
        "offset": 0
      }
    },
    "x": {
      "field": "Housing share",
      "type": "quantitative",
      "axis": {
        "title": "Housing as % of total spending",
        "titleFontWeight": 700,
        "titleFontSize": 12,
        "titleColor": "#666666",
        "titleAnchor": "start",
        "titleAngle": 0,
        "titleX": 0,
        "titleY": -15,
        "labelFontSize": 12,
        "labelColor": "#666666",
        "domainColor": "#d0d0d0",
        "domainWidth": 1.5,
        "gridColor": "#e8e8e8",
        "gridOpacity": 1,
        "gridDash": [3, 3],
        "labelPadding": 8,
        "ticks": false,
        "offset": 10
      }
    },
    "yOffset": {"field": "Status"},
    "color": {
      "field": "Status",
      "type": "nominal",
      "scale": {
        "domain": ["No children", "With children"],
        "range": ["#5A7FE6", "#c41e3a"]
      },
      "legend": {
        "title": "Family Status",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "labelFontSize": 12,
        "titleColor": "#666666",
        "labelColor": "#666666",
        "orient": "right",
        "offset": 20
      }
    },
    "tooltip": [
      {
        "field": "Income quintile",
        "type": "nominal",
        "title": "Income Quintile"
      },
      {"field": "Status", "type": "nominal", "title": "Family Status"},
      {
        "field": "Housing share",
        "type": "quantitative",
        "format": ".1f",
        "title": "Housing as % of spending"
      }
    ]
  },
  "config": {
    "background": "#ffffff",
    "font": "Outfit, sans-serif",
    "title": {
      "font": "Outfit, sans-serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1a1a1a",
      "anchor": "start",
      "offset": 25,
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#999999"
    },
    "axis": {
      "labelFont": "Outfit, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#666666",
      "titleFont": "Outfit, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#666666",
      "domainColor": "#d0d0d0",
      "domainWidth": 1,
      "gridColor": "#e8e8e8",
      "gridOpacity": 1,
      "gridDash": [3, 3],
      "labelPadding": 10,
      "ticks": false,
      "offset": 5
    },
    "legend": {"disable": false},
    "view": {
      "stroke": "transparent",
      "continuousWidth": 500,
      "continuousHeight": 350
    }
  }
}
