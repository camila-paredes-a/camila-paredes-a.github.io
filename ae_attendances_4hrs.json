{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "A&E Attendances exceeding 4 hours",
    "fontSize": 18,
    "font": "Outfit nova, sans-serif",
    "anchor": "start",
    "color": "#1F2A44",
    "subtitle": "From arrival to admission, transfer or discharge (2003-2024)"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/camila-paredes-a/camila-paredes-a.github.io/refs/heads/main/waiting_times_p.csv"
  },
  "width": 500,
  "height": 350,
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 10,
        "domain": false,
        "ticks": false,
        "labelColor": "#666",
        "grid": false,
        "labelPadding": 15
      }
    },
    "y": {
      "field": "Attendance",
      "type": "quantitative",
      "title": "Attendances (millions)",
      "axis": {
        "labelFontSize": 10,
        "labelColor": "#666",
        "labelExpr": "datum.value / 1000000 + 'm'",
        "format": ".1f",
        "grid": true,
        "gridColor": "#e0e0e0",
        "gridOpacity": 0.4,
        "ticks": false,
        "labelOffset": 5,
        "labelPadding": 5
      }
    },
    "tooltip": [
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {
        "field": "Attendance",
        "type": "quantitative",
        "title": "Attendances > 4hrs",
        "format": ",.0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#ff8c42",
        "opacity": 0.15,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#ff8c42",
        "size": 4,
        "point": {"color": "#ff8c42", "size": 80, "filled": true},
        "interpolate": "monotone"
      }
    }
  ],
  "config": {
    "view": {"stroke": null, "fill": "#ffffff"},
    "font": "Outfit, sans-serif",
    "background": "white"
  }
}
